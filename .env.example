# Active driver: brevo (temporary) or infomaniak (Swiss SMTP)
MAIL_PROVIDER=brevo
# Brevo v3 key (xkeysib-...); turn open/click tracking OFF in Brevo transactional settings
BREVO_API_KEY=
# Transactional mail — Infomaniak SMTP (Swiss). 465 = SSL, 587 = STARTTLS
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER_AUTH=auth@rout.be
SMTP_PASS_AUTH=
SMTP_USER_SYSTEM=system@rout.be
SMTP_PASS_SYSTEM=
# Optional secondary HTTPS API, used only on SMTP timeout/network errors (Postmark-compatible)
FALLBACK_MAIL_API_KEY=
# FALLBACK_MAIL_API_URL=https://api.postmarkapp.com/email
# Where contact forms and delivery alerts land
CONTACT_ADMIN_EMAIL=hallo@rout.be
